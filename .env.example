# Zelora environment variables
#
# All values shown are the defaults used when the variables are not set.
# Nothing reads a `.env` file yet; exporting these variables (or setting
# them in your shell/CI) is sufficient. A `.env` loader will be added in
# a later phase together with the data layer.

# Node environment: development | test | production
NODE_ENV=development

# HTTP host/port for the Hono API (apps/api)
HOST=127.0.0.1
PORT=3001

# Application version reported by GET /api/health
APP_VERSION=0.1.0

# Allowed browser origin for the API's CORS policy (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# HttpOnly session cookie name set on register/login (Phase 3).
SESSION_COOKIE_NAME=zelora_session

# Session lifetime in seconds before the cookie and its server-side session expire.
SESSION_TTL_SECONDS=2592000

# Whether the session cookie is marked Secure. Defaults to true when
# NODE_ENV=production; set to false for plain-HTTP local development.
#
# Cloudflare Workers local development (wrangler dev) serves over plain HTTP on
# localhost, where browsers drop Secure cookies. Run the Worker with
# NODE_ENV=development (the cookie then defaults to non-Secure) and never set
# SESSION_COOKIE_SECURE=true there — the Worker rejects that combination at
# startup instead of silently breaking local authentication.
SESSION_COOKIE_SECURE=false

# PBKDF2-HMAC-SHA256 iteration count for password hashing (OWASP default 210000).
# Tests/dev tooling may lower this; production should keep the default.
#
# Cloudflare Workers Web Crypto rejects PBKDF2 iteration counts above 100000,
# while the Node runtime can handle the higher OWASP default. The Worker caps
# PBKDF2_ITERATIONS at 100000 and refuses larger explicit values with a clear
# config error, so a value copied from a Node-tuned environment can never crash
# hashing on the edge. Keep this at or below 100000 when running on Workers.
PBKDF2_ITERATIONS=210000

# Admin bootstrap secret (Phase 2). When left unset the bootstrap endpoint is
# disabled entirely (404). When set it must be at least 32 characters and is
# presented in the X-Zelora-Admin-Bootstrap header on the very first admin
# creation; the endpoint turns into a clean 404 once the first admin exists, so
# a leaked header value cannot harm a provisioned deployment. Never commit a
# real value here. On Cloudflare Workers this is a secret binding, set with
#   wrangler secret put ADMIN_BOOTSTRAP_SECRET
# (it must never be placed in wrangler.jsonc `vars`).
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret

# Authentication rate limiting (Phase 3). Master switch: set to false to fully
# disable IP and email throttling while keeping behavior identical otherwise.
RATE_LIMIT_ENABLED=true

# Trust the first X-Forwarded-For entry as the client address. Keep false unless
# the Node API sits behind a single proxy you control that always rewrites the
# header; this is never consulted when disabled (the TCP peer address is used).
# On a future Cloudflare Workers deployment the runtime resolves the real client
# address directly and this flag is irrelevant.
RATE_LIMIT_TRUST_PROXY=false

# Login attempts allowed per IP address per window.
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900

# Login attempts allowed against one normalized email per window. Exceeding this
# never reveals account existence: the response stays a generic 401.
RATE_LIMIT_LOGIN_EMAIL_MAX=10
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900

# Account registrations allowed per IP address per window.
RATE_LIMIT_REGISTER_IP_MAX=10
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600

# Seller onboarding submissions allowed per IP address per window.
RATE_LIMIT_SELLER_ONBOARDING_IP_MAX=10
RATE_LIMIT_SELLER_ONBOARDING_IP_WINDOW_SECONDS=3600

# Product creations allowed per IP address per window.
RATE_LIMIT_PRODUCT_CREATE_IP_MAX=30
RATE_LIMIT_PRODUCT_CREATE_IP_WINDOW_SECONDS=3600

# Local development SQLite database file used by packages/db
# (drizzle-kit migrations, the seed CLI and local tooling). Cloudflare D1 is
# the future production database and needs no path here.
ZELORA_DB_PATH=.data/zelora.db