{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "zelora-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-01",
  "vars": {
    // Production browser origin for the API's CORS policy. Keep in sync with
    // the deployed frontend (https://zelora-web.farqas007.workers.dev).
    "CORS_ORIGIN": "https://zelora-web.farqas007.workers.dev",

    // D1 is the media backend. Product-image bytes are stored in the `media_objects`
    // table through the existing `DB` binding, so media needs no bucket, no
    // object store and no additional Cloudflare service (see the D1 media storage
    // driver in src/services/media/d1.ts).
    //
    // This is the setting that keeps the R2 backend from ever being selected: the
    // code's own default stays "r2" so no existing deployment changes behaviour by
    // upgrading, and pinning it here to "d1" is what makes THIS deployment
    // D1-backed without touching that default.
    "MEDIA_BACKEND": "d1",

    // Absolute base the stored media is publicly readable from. It must end in
    // `/media`, because that is the path the public media route is mounted at
    // (see src/routes/media.ts and the `/media` mount in src/app.ts): a stored
    // key is appended to this base verbatim, and the resulting URL is what ends up
    // in `product_images.url`.
    //
    // Required to enable media at all. While it is unset the media storage port
    // stays fail-closed and both the upload and the read path fail loudly instead
    // of storing bytes whose URLs resolve to nothing.
    "MEDIA_PUBLIC_BASE_URL": "https://zelora-api.farqas007.workers.dev/media"

    // !!! SECRET — NEVER ADD A REAL VALUE TO `vars` !!!
    // The first-admin bootstrap secret lives in a Cloudflare secret binding, set
    // with a secret-put command, not in this file:
    //
    //   wrangler secret put ADMIN_BOOTSTRAP_SECRET
    //
    // It is consumed by POST /api/admin/bootstrap (see src/services/admin.ts).
    // Leaving it unset keeps the endpoint disabled (404). Anyone can read this
    // file in the repository, so any secret value here is compromised directly.

    // Local development (wrangler dev) serves over plain HTTP on localhost,
    // where browsers drop Secure cookies and auth silently breaks. Run the
    // Worker locally with an explicit development posture:
    //
    //   wrangler dev --var NODE_ENV:development
    //                --var SESSION_COOKIE_SECURE:false
    //                --var CORS_ORIGIN:http://localhost:5173
    //
    // The Worker defaults NODE_ENV to production (Secure cookies, correct for
    // the deployed edge) and refuses SESSION_COOKIE_SECURE=true in a
    // development environment with a clear startup error.
  },
  // Hourly sweep that runs the `scheduled` handler in src/worker.ts, which
  // purges expired auth sessions (see sessionPurgeIntervalSeconds in
  // packages/core/src/config.ts for the equivalent Node-server cadence).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      // Raw D1 binding name, exposed to the Worker as `env.DB`.
      "binding": "DB",
      "database_name": "zelora",
      // database_id contains the real Cloudflare D1 database ID for the zelora
      // database. It is configuration/identification data, not a secret.
      "database_id": "245a64cf-0841-4faf-978c-171c03fd0dc8",
      // Reuses the existing Drizzle migrations (packages/db/migrations),
      // resolved relative to this config file (apps/api).
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
