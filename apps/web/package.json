{
  "name": "@zelora/web",
  "version": "0.1.0",
  "private": true,
  "description": "Zelora web application (React + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && pnpm -w exec wrangler deploy --config apps/web/wrangler.jsonc"
  },
  "dependencies": {
    "@zelora/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.0.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}