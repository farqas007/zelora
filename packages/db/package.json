{
  "name": "@zelora/db",
  "version": "0.1.0",
  "private": true,
  "description": "Zelora database layer: Drizzle schema, SQLite/D1 clients, migrations and schema tests.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema/auth": {
      "types": "./src/schema/auth.ts",
      "default": "./src/schema/auth.ts"
    },
    "./ids": {
      "types": "./src/ids.ts",
      "default": "./src/ids.ts"
    },
    "./d1": {
      "types": "./src/d1.ts",
      "default": "./src/d1.ts"
    },
    "./auth": {
      "types": "./src/auth/repository.ts",
      "default": "./src/auth/repository.ts"
    },
    "./auth/local": {
      "types": "./src/auth/local-repository.ts",
      "default": "./src/auth/local-repository.ts"
    },
    "./auth/d1": {
      "types": "./src/auth/d1-repository.ts",
      "default": "./src/auth/d1-repository.ts"
    },
    "./users": {
      "types": "./src/users/repository.ts",
      "default": "./src/users/repository.ts"
    },
    "./users/local": {
      "types": "./src/users/local-repository.ts",
      "default": "./src/users/local-repository.ts"
    },
    "./users/d1": {
      "types": "./src/users/d1-repository.ts",
      "default": "./src/users/d1-repository.ts"
    },
    "./seller": {
      "types": "./src/seller/repository.ts",
      "default": "./src/seller/repository.ts"
    },
    "./seller/local": {
      "types": "./src/seller/local-repository.ts",
      "default": "./src/seller/local-repository.ts"
    },
    "./seller/d1": {
      "types": "./src/seller/d1-repository.ts",
      "default": "./src/seller/d1-repository.ts"
    },
    "./catalog": {
      "types": "./src/catalog/repository.ts",
      "default": "./src/catalog/repository.ts"
    },
    "./catalog/local": {
      "types": "./src/catalog/local-repository.ts",
      "default": "./src/catalog/local-repository.ts"
    },
    "./catalog/d1": {
      "types": "./src/catalog/d1-repository.ts",
      "default": "./src/catalog/d1-repository.ts"
    },
    "./products": {
      "types": "./src/products/repository.ts",
      "default": "./src/products/repository.ts"
    },
    "./products/local": {
      "types": "./src/products/local-repository.ts",
      "default": "./src/products/local-repository.ts"
    },
    "./products/d1": {
      "types": "./src/products/d1-repository.ts",
      "default": "./src/products/d1-repository.ts"
    },
    "./audit": {
      "types": "./src/audit/repository.ts",
      "default": "./src/audit/repository.ts"
    },
    "./audit/local": {
      "types": "./src/audit/local-repository.ts",
      "default": "./src/audit/local-repository.ts"
    },
    "./audit/d1": {
      "types": "./src/audit/d1-repository.ts",
      "default": "./src/audit/d1-repository.ts"
    },
    "./cart": {
      "types": "./src/cart/repository.ts",
      "default": "./src/cart/repository.ts"
    },
    "./cart/local": {
      "types": "./src/cart/local-repository.ts",
      "default": "./src/cart/local-repository.ts"
    },
    "./cart/d1": {
      "types": "./src/cart/d1-repository.ts",
      "default": "./src/cart/d1-repository.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p .data && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --verbose",
    "db:seed": "npm run db:migrate && tsx seed/dev.ts",
    "db:seed:d1": "tsx seed/d1.ts apply --database zelora --yes",
    "db:seed:d1:plan": "tsx seed/d1.ts plan",
    "db:seed:d1:cleanup": "tsx seed/d1.ts cleanup --database zelora --yes",
    "db:seed:d1:verify": "tsx seed/d1.ts verify --database zelora",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zelora/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@zelora/core": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "miniflare": "4.20260730.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}